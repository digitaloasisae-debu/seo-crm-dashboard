# --- Database (Supabase: Project Settings > Database > Connection string) ---
# Pooled connection (port 6543) for the app
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for migrations
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Public URL of the dashboard (used in links and Tally prefill URLs)
APP_URL="https://your-dashboard.vercel.app"

# --- Encryption for WordPress app passwords ---
# Generate with: npm run gen:key   (32 random bytes, base64). NEVER commit or lose this:
# without it the stored WordPress passwords cannot be decrypted.
ENCRYPTION_KEY=""
# Bump when you rotate keys; keep the old key as ENCRYPTION_KEY_<n> until re-encrypted.
ENCRYPTION_KEY_VERSION=1

# --- Super Admin created by `npm run db:seed` ---
SEED_ADMIN_NAME="Hamza"
SEED_ADMIN_EMAIL="digitaloasisae@gmail.com"
SEED_ADMIN_PASSWORD=""

# --- Tally (Form settings > Integrations > Webhooks > Signing secret) ---
TALLY_ONBOARDING_SIGNING_SECRET=""
TALLY_KEYWORDS_SIGNING_SECRET=""
# Public link of the Keyword form (e.g. https://tally.so/r/abc123). Each client page shows it
# with ?client_slug=<slug> so submissions always match the right client.
TALLY_KEYWORDS_FORM_URL=""

# --- n8n (self-hosted on Hostinger) ---
# Bearer token n8n sends to /api/n8n/*. Generate with: openssl rand -hex 32
N8N_API_TOKEN=""
# Optional comma-separated IP allowlist for /api/n8n/* (your Hostinger VPS public IP)
N8N_ALLOWED_IPS=""
# Optional: n8n Webhook-trigger URLs the dashboard calls for "Generate now" buttons
N8N_WF1_WEBHOOK_URL=""
N8N_WF2_WEBHOOK_URL=""

# Google PageSpeed Insights API key (Google Cloud > APIs & Services > Credentials). Free; without it the daily quota is tiny.
PAGESPEED_API_KEY=""

# Google Search Console (Google Cloud > Credentials > OAuth client, type "Web application").
# Authorized redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/gsc (daily sync)
CRON_SECRET=""

# Gemini (Google AI Studio) for the SOP AI review and each client's learning brain
GEMINI_API_KEY=""
# Optional, defaults to gemini-flash-latest
GEMINI_MODEL=""
