generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- People & access ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum AccessLevel {
  OWNER // the member responsible for the client
  EDIT // granted: can approve and push
  VIEW // granted: read only
}

model SiteAudit {
  id           String      @id @default(cuid())
  clientId     String
  status       AuditStatus @default(RUNNING)
  score        Int?
  pagesChecked Int         @default(0)
  // PageSpeed Insights summary per strategy: { performance, seo, accessibility, bestPractices, lcpMs, cls, tbtMs, fcpMs }
  psiMobile    Json?
  psiDesktop   Json?
  // [{ code, severity: "error"|"warning"|"notice", title, urls: string[], count }]
  issues       Json?
  error        String?
  startedById  String?
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
}

enum AuditStatus {
  RUNNING
  DONE
  FAILED
}

// ---------- Google Search Console ----------

model GoogleConnection {
  id               String   @id @default(cuid())
  email            String   @unique
  refreshEncrypted String
  iv               String
  keyVersion       Int
  connectedById    String?
  lastError        String?
  /// space-separated OAuth scopes Google granted (null = connected before we tracked it)
  scopes           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clients Client[]
}

// Daily site totals, for trend charts.
model GscDaily {
  clientId    String
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  position    Float

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, date])
}

// Top queries per week (week = Monday). Position is impression-weighted when summed.
model GscQueryWeek {
  clientId    String
  weekStart   DateTime @db.Date
  query       String
  clicks      Int
  impressions Int
  position    Float

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, weekStart, query])
  @@index([clientId, query])
}

// Pages per week (week = Monday): ranking history for each article.
model GscPageWeek {
  clientId    String
  weekStart   DateTime @db.Date
  page        String
  clicks      Int
  impressions Int
  position    Float

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, weekStart, page])
  @@index([clientId, page])
}

// Top pages over the latest 28 days (replaced on each sync).
model GscPage {
  clientId    String
  page        String
  clicks      Int
  impressions Int
  position    Float

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, page])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments     ClientAssignment[] @relation("AssignmentUser")
  grantsGiven     ClientAssignment[] @relation("AssignmentGrantedBy")
  accessRequests  AccessRequest[]    @relation("RequestRequester")
  accessDecisions AccessRequest[]    @relation("RequestDecider")
  activity        ActivityLog[]
  articleNotes    ArticleNote[]
}

model ClientAssignment {
  id          String      @id @default(cuid())
  clientId    String
  userId      String
  access      AccessLevel
  grantedById String?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User   @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?  @relation("AssignmentGrantedBy", fields: [grantedById], references: [id])

  @@unique([clientId, userId])
  @@index([userId])
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

model AccessRequest {
  id          String        @id @default(cuid())
  clientId    String
  requesterId String
  access      AccessLevel   @default(VIEW)
  reason      String?
  status      RequestStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requester User   @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("RequestDecider", fields: [decidedById], references: [id])

  @@index([status])
}

// ---------- Clients ----------

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Client {
  id                  String       @id @default(cuid())
  name                String       @unique
  slug                String       @unique
  status              ClientStatus @default(ACTIVE)
  siteUrl             String
  businessType        String?
  targetCountry       String?
  primaryCity         String?
  serviceAreaCities   String[]
  servicesOffered     String[]
  targetAudience      String?
  competitors         String[]
  brandVoiceAvoid     String?
  ctaText             String?
  ctaLink             String?
  postsPerMonth       Int          @default(0)
  preferredDates      String[] // YYYY-MM-DD from Tally, empty = auto-schedule
  imageRequired       Boolean      @default(false)
  imageStyle          String?
  referenceImages     String[]
  cmsPlatform         String?
  cmsPreviewSupported Boolean      @default(false)
  linkPool            String[]
  socialLinks         String[]
  masterTemplateUrl   String?
  gscAccount          String?
  brandPrimaryColor   String?
  brandSecondaryColor String?
  brandAccentColor    String?
  logoUrl             String?
  autoApproveKeywords Boolean      @default(true)
  submittedBy         String?
  onboardedAt         DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  credentials     ClientCredential[]
  brain           ClientBrain?
  assignments     ClientAssignment[]
  accessRequests  AccessRequest[]
  postingSlots    PostingSlot[]
  keywords        Keyword[]
  topics          Topic[]
  articles        Article[]
  audits          SiteAudit[]
  gscProperty     String?
  gscConnectionId String?
  gscSyncedAt     DateTime?
  gscError        String?
  gscConnection   GoogleConnection?  @relation(fields: [gscConnectionId], references: [id], onDelete: SetNull)
  gscDaily        GscDaily[]
  gscQueries      GscQueryWeek[]
  gscPages        GscPage[]
  gscPageWeeks    GscPageWeek[]
  crawls          SiteCrawl[]
  backlinkReports BacklinkReport[]
  ga4PropertyId   String?
  ga4PropertyName String?
  ga4ConnectionId String?
  ga4SyncedAt     DateTime?
  ga4Error        String?
  analytics       AnalyticsSnapshot?
}

enum CredentialKind {
  WORDPRESS
}

/// Secrets are AES-256-GCM encrypted (see src/lib/crypto.ts). Plaintext is never stored.
model ClientCredential {
  id              String         @id @default(cuid())
  clientId        String
  kind            CredentialKind
  endpoint        String // e.g. https://clientsite.com/wp-json/wp/v2/posts
  username        String
  secretEncrypted String // base64 ciphertext + auth tag
  iv              String // base64
  keyVersion      Int
  lastVerifiedAt  DateTime?
  lastError       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind])
}

model PostingSlot {
  id            String   @id @default(cuid())
  clientId      String
  scheduledDate DateTime @db.Date
  articleId     String?  @unique
  createdAt     DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([clientId, scheduledDate])
}

// ---------- Content pipeline ----------

enum KeywordStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KeywordSource {
  TALLY
  MANUAL
  API
  IMPORT
}

model Keyword {
  id               String        @id @default(cuid())
  clientId         String
  keyword          String
  keywordNorm      String // lower-cased, trimmed; used for de-duplication
  category         String?
  searchVolume     Int?
  difficulty       Int?
  volumeVerified   Boolean       @default(false)
  cpc              Float?
  intent           String?
  /// When DataForSEO last checked volume and difficulty.
  metricsCheckedAt DateTime?
  status           KeywordStatus @default(PENDING)
  used             Boolean       @default(false)
  usedAt           DateTime?
  source           KeywordSource @default(MANUAL)
  submittedBy      String?
  approvedById     String?
  addedAt          DateTime      @default(now())

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@unique([clientId, keywordNorm])
  @@index([clientId, status, used])
}

enum TopicStatus {
  GENERATED
  APPROVED
  REJECTED
}

model Topic {
  id                String      @id @default(cuid())
  clientId          String
  keywordId         String?
  keyword           String // focus keyword text, kept even if the keyword row is deleted
  secondaryKeywords String[]
  title             String
  category          String?
  angle             String?
  status            TopicStatus @default(GENERATED)
  reviewNote        String?
  approvedById      String?
  generatedAt       DateTime    @default(now())

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keywordRow Keyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  article    Article?

  @@index([clientId, status])
}

enum ArticleStatus {
  GENERATING
  READY_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUSHING
  PUSHED_DRAFT
  PUSH_FAILED
}

model Article {
  id               String        @id @default(cuid())
  clientId         String
  topicId          String        @unique
  metaTitle        String
  slug             String
  metaDescription  String?
  focusKeyword     String
  bodyHtml         String
  featuredImageUrl String?
  status           ArticleStatus @default(READY_FOR_REVIEW)
  reviewNote       String?
  approvedById     String?
  approvedAt       DateTime?
  wpPostId         Int?
  wpPostUrl        String?
  wpMediaId        Int?
  pushAttempts     Int           @default(0)
  lastPushError    String?
  pushedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  qualityScore     Int?
  qualityReport    Json?
  qualityCheckedAt DateTime?
  aiReviewedAt     DateTime?
  revisingAt       DateTime?
  /// Content score vs Google's top 10 for the focus keyword.
  contentScore     Int?
  contentReport    Json?
  contentCheckedAt DateTime?
  reviseError      String?
  /// SOP auto-fix: score before the fix, and when it ran. The score after is qualityScore.
  sopFixFrom       Int?
  sopFixAt         DateTime?
  sopFixNote       String?

  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  topic       Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  postingSlot PostingSlot?
  notes       ArticleNote[]
  revisions   ArticleRevision[]

  @@index([clientId, status])
}

enum NoteKind {
  GENERAL
  CONTENT
  TITLE
  IMAGE
}

/// Feedback a team member leaves on an article. Each note teaches the client's brain.
model ArticleNote {
  id        String    @id @default(cuid())
  articleId String
  clientId  String
  authorId  String?
  kind      NoteKind  @default(GENERAL)
  quote     String?
  body      String
  learnedAt DateTime?
  /// Set when an AI rewrite of the article used this note.
  appliedAt DateTime?
  createdAt DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

/// The version of an article before an AI rewrite, so it can be restored.
model ArticleRevision {
  id              String   @id @default(cuid())
  articleId       String
  metaTitle       String
  metaDescription String?
  bodyHtml        String
  /// What the team asked for, and what the AI says it changed.
  request         String
  changes         String[]
  createdById     String?
  createdAt       DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

/// The per-client learning agent's memory: rules distilled from notes, edits and results. Sent to n8n with every article job.
model ClientBrain {
  clientId          String    @id
  rules             String    @default("")
  version           Int       @default(0)
  lastLearnedAt     DateTime?
  /// When the brain last learned from Search Console results.
  rankingsLearnedAt DateTime?
  lastError         String?
  updatedById       String?
  updatedAt         DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Small key/value settings editable in the app (e.g. the SOP text).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Intake & audit ----------

enum FormKind {
  ONBOARDING
  KEYWORDS
}

model FormSubmission {
  id                String    @id @default(cuid())
  form              FormKind
  tallySubmissionId String    @unique
  payload           Json // raw Tally body with the WordPress password removed
  // The WordPress password from the form, encrypted on arrival so a retry can still use it
  secretEncrypted   String?
  secretIv          String?
  secretKeyVersion  Int?
  clientId          String?
  processedAt       DateTime?
  error             String?
  receivedAt        DateTime  @default(now())
}

model ActivityLog {
  id       String   @id @default(cuid())
  actorId  String? // null = system / n8n / Tally
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorTag String? // "n8n", "tally", "import" when there is no user
  clientId String?
  action   String // e.g. "keyword.approve", "article.push"
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([clientId, at])
  @@index([entity, entityId])
}

/// Google top-10 analysis for a keyword in a country (shared by all clients, cached ~2 weeks).
model SerpBenchmark {
  id        String   @id @default(cuid())
  keyword   String
  location  String
  data      Json
  fetchedAt DateTime @default(now())

  @@unique([keyword, location])
}

enum CrawlStatus {
  RUNNING
  DONE
  FAILED
}

/// Full technical audit: a DataForSEO On-Page crawl of the whole site.
model SiteCrawl {
  id           String      @id @default(cuid())
  clientId     String
  status       CrawlStatus @default(RUNNING)
  taskId       String?
  target       String
  maxPages     Int
  pagesCrawled Int         @default(0)
  pagesInQueue Int         @default(0)
  score        Int?
  /// { ssl, sitemap, robots, http2, cms, server, ... } from DataForSEO domain_info
  domainInfo   Json?
  /// [{ code, severity, title, hint, count, urls: string[] }]
  issues       Json?
  /// page_metrics totals (links, duplicates, broken, non-indexable...)
  metrics      Json?
  error        String?
  startedById  String?
  startedAt    DateTime    @default(now())
  lastPolledAt DateTime?
  finishedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
}

/// One Backlinks API snapshot for a client (DataForSEO). Kept for history.
model BacklinkReport {
  id          String   @id @default(cuid())
  clientId    String
  target      String
  /// backlinks/summary: rank, backlinks, referring_domains, spam score, dofollow split...
  summary     Json
  /// monthly [{ date, backlinks, referringDomains, newDomains, lostDomains, rank }]
  history     Json?
  /// top referring domains
  domains     Json?
  /// best backlinks (one per domain) with new/lost flags
  links       Json?
  anchors     Json?
  /// [{ target, rank, backlinks, referringDomains, you }]
  competitors Json?
  /// link gap: domains linking to competitors but not to this client
  gap         Json?
  createdById String?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

/// Latest Google Analytics 4 numbers for a client (replaced on every sync).
model AnalyticsSnapshot {
  clientId  String   @id
  /// { days, current, previous, daily[], channels[], pages[], organicPages[], events[] }
  data      Json
  fetchedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
