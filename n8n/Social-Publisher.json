    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('One Item Per Platform').item.json;\nconst r = $json || {};\nconst id = r.post_id || r.id || '';\nconst err = r.error ? (r.error.message || JSON.stringify(r.error)) : ($('Get Page Token (FB)').item.json.error ? 'Page token: ' + ($('Get Page Token (FB)').item.json.error.message || 'failed') : '');\nreturn { json: { post_id: p.post_id, platform: 'facebook', id: err ? '' : id, url: id && !err ? 'https://www.facebook.com/' + id : '', error: err || (id ? '' : 'No post id returned') } };"
      },
