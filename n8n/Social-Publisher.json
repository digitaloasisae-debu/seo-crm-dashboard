    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('One Item Per Platform').item.json;\nconst c = $('IG Create Container').item.json || {};\nconst pub = $('IG Publish').item.json || {};\nconst e = c.error || pub.error;\nconst err = e ? (e.message || JSON.stringify(e)) : (!c.id ? 'Instagram did not accept the image' : '');\nreturn { json: { post_id: p.post_id, platform: 'instagram', id: err ? '' : (pub.id || ''), url: ($json && $json.permalink) || '', error: err || (pub.id ? '' : 'No media id returned') } };"
      },
