        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('One Item Per Platform').item.json;\nconst li = $('Post to LinkedIn').item.json || {};\nconst id = li.urn || li.id || '';\nconst err = li.error ? (li.error.message || JSON.stringify(li.error)) : '';\nreturn { json: { post_id: p.post_id, platform: 'linkedin', id: err ? '' : id, url: String(id).startsWith('urn:') ? 'https://www.linkedin.com/feed/update/' + id : '', error: err || (id ? '' : 'No post id returned') } };"
      },
