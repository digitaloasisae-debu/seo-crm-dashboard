    {
      "parameters": {
        "jsCode": "const content = items[0].json.content;\nconst responseText = content?.parts?.find(p => p.text)?.text;\n\nif (!responseText) {\n  throw new Error('No topics text returned from Gemini');\n}\n\nconst cleaned = responseText.replace(/```json|```/g, '').trim();\nlet topics;\ntry {\n  topics = JSON.parse(cleaned);\n} catch (e) {\n  const lastComplete = cleaned.lastIndexOf('},');\n  if (lastComplete === -1) return [];\n  topics = JSON.parse(cleaned.substring(0, lastComplete + 1) + ']');\n}\n\nconst clientName = $('Select Top 10 Unused Approved').first().json.client_name;\nconst today = new Date().toISOString().split('T')[0];\n\nreturn topics.map(t => ({\n  json: {\n    client_name: clientName,\n    keyword: t.keyword,\n    category: t.category,\n    topic: t.topic,\n    angle: t.angle,\n    date_generated: today,\n    topic_status: '',\n    blog_status: ''\n  }\n}));"
      },
      "name": "Parse Topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
