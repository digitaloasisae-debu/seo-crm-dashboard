              "content": "=={{ \"Read this business's website content and identify exactly what specific services, products, or courses it offers. Website content: \" + $json.data.markdown.substring(0, 1500) + \". Return ONLY a JSON object: {\\\"core_services\\\": [\\\"...\\\"], \\\"industry_summary\\\": \\\"...\\\"}. Be specific and narrow. No other text, no markdown.\" }}"
            }
          ]
        },
        "builtInTools": {},
