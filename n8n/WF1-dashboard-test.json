    {
      "parameters": {
        "jsCode": "const responseText = items[0].json.content.parts[0].text;\nconst profile = JSON.parse(responseText.replace(/```json|```/g, '').trim());\nconst client = $('Loop Over Clients').item.json;\nreturn [{\n  json: {\n    client_name: client.client_name,\n    site_url: client.site_url,\n    core_services: profile.core_services,\n    industry_summary: profile.industry_summary\n  }\n}];"
      },
      "name": "Parse Business Profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
        96
      ],
      "id": "db4635ca-2424-432f-b9f7-f487f5e39fd4"
    },
    {
      "parameters": {
        "jsCode": "const profile = $('Parse Business Profile').first().json;\n\n// Read Keyword Pool returns approved, unused keywords from the dashboard (oldest first).\nconst eligible = items.filter(item => item.json.keyword);\n\nif (eligible.length === 0) {\n  throw new Error(`No approved, unused keywords found for ${profile.client_name}`);\n}\n\nconst selected = eligible.slice(0, 25).map(item => ({\n  keyword: item.json.keyword,\n  category: item.json.category || ''\n}));\n\nreturn [{\n  json: {\n    client_name: profile.client_name,\n    site_url: profile.site_url,\n    core_services: profile.core_services,\n    industry_summary: profile.industry_summary,\n    selected\n  }\n}];"
      },
      "name": "Select Top 10 Unused Approved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        96
      ],
      "id": "112d09b3-b41e-4018-8bd7-688af4b7cafe"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1c1c1c1-0001-0001-0001-000000000001",
              "leftValue": "={{ $json.selected.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
